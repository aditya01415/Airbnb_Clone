<% layout('layouts/boilerplate') %>

<!-- Category Filters Bar & Tax Toggle -->
<div id="filters" class="d-flex align-items-center justify-content-between my-3 flex-wrap gap-2">
  <div class="filter-container d-flex align-items-center overflow-auto pe-2">
    <a href="/listings" class="filter-item text-decoration-none me-4 text-center <%= !activeCategory ? 'filter-active' : '' %>">
      <div><i class="fa-solid fa-fire"></i></div>
      <p class="filter-label">Trending</p>
    </a>
    <a href="/listings?category=rooms" class="filter-item text-decoration-none me-4 text-center <%= activeCategory === 'rooms' ? 'filter-active' : '' %>">
      <div><i class="fa-solid fa-bed"></i></div>
      <p class="filter-label">Rooms</p>
    </a>
    <a href="/listings?category=cities" class="filter-item text-decoration-none me-4 text-center <%= activeCategory === 'cities' ? 'filter-active' : '' %>">
      <div><i class="fa-solid fa-city"></i></div>
      <p class="filter-label">Iconic Cities</p>
    </a>
    <a href="/listings?category=mountains" class="filter-item text-decoration-none me-4 text-center <%= activeCategory === 'mountains' ? 'filter-active' : '' %>">
      <div><i class="fa-solid fa-mountain-sun"></i></div>
      <p class="filter-label">Mountains</p>
    </a>
    <a href="/listings?category=castles" class="filter-item text-decoration-none me-4 text-center <%= activeCategory === 'castles' ? 'filter-active' : '' %>">
      <div><i class="fa-solid fa-chess-rook"></i></div>
      <p class="filter-label">Castles</p>
    </a>
    <a href="/listings?category=pools" class="filter-item text-decoration-none me-4 text-center <%= activeCategory === 'pools' ? 'filter-active' : '' %>">
      <div><i class="fa-solid fa-water-ladder"></i></div>
      <p class="filter-label">Amazing Pools</p>
    </a>
    <a href="/listings?category=camping" class="filter-item text-decoration-none me-4 text-center <%= activeCategory === 'camping' ? 'filter-active' : '' %>">
      <div><i class="fa-solid fa-campground"></i></div>
      <p class="filter-label">Camping</p>
    </a>
    <a href="/listings?category=farms" class="filter-item text-decoration-none me-4 text-center <%= activeCategory === 'farms' ? 'filter-active' : '' %>">
      <div><i class="fa-solid fa-cow"></i></div>
      <p class="filter-label">Farms</p>
    </a>
    <a href="/listings?category=arctic" class="filter-item text-decoration-none me-4 text-center <%= activeCategory === 'arctic' ? 'filter-active' : '' %>">
      <div><i class="fa-solid fa-snowflake"></i></div>
      <p class="filter-label">Arctic</p>
    </a>
    <a href="/listings?category=boats" class="filter-item text-decoration-none me-4 text-center <%= activeCategory === 'boats' ? 'filter-active' : '' %>">
      <div><i class="fa-solid fa-ship"></i></div>
      <p class="filter-label">Boats</p>
    </a>
    <a href="/listings?category=domes" class="filter-item text-decoration-none me-4 text-center <%= activeCategory === 'domes' ? 'filter-active' : '' %>">
      <div><i class="fa-solid fa-igloo"></i></div>
      <p class="filter-label">Domes</p>
    </a>
  </div>

  <div class="tax-toggle border rounded-pill px-3 py-2 ms-auto d-flex align-items-center shadow-sm">
    <div class="form-check form-switch form-check-reverse m-0">
      <input class="form-check-input" type="checkbox" role="switch" id="taxSwitch">
      <label class="form-check-label fw-semibold text-secondary me-2 fs-7" for="taxSwitch">Display total after taxes</label>
    </div>
  </div>
</div>

<% if (searchQuery) { %>
  <div class="mb-3 d-flex align-items-center justify-content-between">
    <h5 class="text-secondary">Search results for "<span class="text-dark fw-bold"><%= searchQuery %></span>"</h5>
    <a href="/listings" class="btn btn-sm btn-outline-secondary rounded-pill"><i class="fa-solid fa-xmark me-1"></i> Clear Search</a>
  </div>
<% } %>

<% if (listings.length === 0) { %>
  <div class="text-center py-5">
    <i class="fa-solid fa-compass-drafting text-muted fs-1 mb-3"></i>
    <h3>No listings found</h3>
    <p class="text-muted">Try adjusting your search criteria or explore all listings.</p>
    <a href="/listings" class="btn btn-danger rounded-pill px-4">Browse All Listings</a>
  </div>
<% } else { %>
  <div class="row row-cols-xl-4 row-cols-lg-3 row-cols-md-2 row-cols-1 g-4 mb-4">
    <% for (let listing of listings) { %>
      <div class="col">
        <a href="/listings/<%= listing._id %>" class="listing-link text-decoration-none text-dark">
          <div class="card h-100 listing-card border-0 shadow-sm rounded-4 overflow-hidden position-relative">
            <div class="img-wrapper overflow-hidden" style="height: 18rem;">
              <img src="<%= listing.image?.url || listing.image %>" class="card-img-top listing-img h-100 w-100 object-fit-cover" alt="<%= listing.title %>">
              <span class="badge bg-dark bg-opacity-75 position-absolute top-0 end-0 m-3 rounded-pill text-capitalize px-3 py-2 fw-medium">
                <%= listing.category || 'trending' %>
              </span>
            </div>
            <div class="card-body p-3">
              <h6 class="card-title fw-bold mb-1 text-truncate"><%= listing.title %></h6>
              <p class="card-text text-muted mb-2 fs-7">
                <i class="fa-solid fa-location-dot me-1 text-danger"></i> <%= listing.location %>, <%= listing.country %>
              </p>
              <div class="d-flex align-items-baseline justify-content-between">
                <div>
                  <span class="fw-bold fs-6 text-dark">&#8377; <%= listing.price.toLocaleString("en-IN") %></span>
                  <span class="text-secondary fs-7"> / night</span>
                  <i class="tax-info text-danger fw-semibold fs-7 ms-1 d-none">+18% GST</i>
                </div>
              </div>
            </div>
          </div>
        </a>
      </div>
    <% } %>
  </div>
<% } %>




