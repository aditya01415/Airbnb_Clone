<% layout('layouts/boilerplate') %>

<div class="row mt-3 justify-content-center">
  <div class="col-12 col-md-10 col-lg-8">
    
    <!-- Title & Location Header -->
    <div class="mb-3">
      <h2 class="fw-bold text-dark mb-1"><%= listing.title %></h2>
      <p class="text-muted fs-6 mb-2">
        <i class="fa-solid fa-location-dot me-1 text-danger"></i> <%= listing.location %>, <%= listing.country %>
        <span class="badge bg-danger-subtle text-danger rounded-pill ms-2 text-capitalize px-3 py-1 fw-medium"><%= listing.category || 'Trending' %></span>
      </p>
    </div>

    <!-- Main Image Card -->
    <div class="card border-0 shadow rounded-4 overflow-hidden mb-4">
      <img src="<%= (listing.image && listing.image.url) ? listing.image.url : (typeof listing.image === 'string' && listing.image !== '' ? listing.image : 'https://images.unsplash.com/photo-1625505826533-5c80aca7d157?auto=format&fit=crop&w=800&q=60') %>" class="card-img-top object-fit-cover" alt="<%= listing.title %>" style="max-height: 450px; width: 100%;">
      <div class="card-body p-4 bg-white">
        <div class="d-flex align-items-center justify-content-between mb-3 pb-3 border-bottom">
          <div class="d-flex align-items-center">
            <div class="owner-avatar bg-dark text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 42px; height: 42px; font-weight: 600;">
              <%= (listing.owner && listing.owner.username) ? listing.owner.username.charAt(0).toUpperCase() : 'O' %>
            </div>
            <div>
              <p class="mb-0 text-muted fs-7">Hosted by</p>
              <h6 class="mb-0 fw-bold"><%= (listing.owner && listing.owner.username) ? listing.owner.username : 'Host' %></h6>
            </div>
          </div>
          <div class="text-end">
            <span class="fs-4 fw-bold text-dark">&#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : 0 %></span>
            <span class="text-muted fs-7"> / night</span>
          </div>
        </div>

        <h5 class="fw-bold mb-2">About this place</h5>
        <p class="card-text text-secondary lh-lg mb-0"><%= listing.description %></p>
      </div>
    </div>

    <!-- Owner Action Controls -->
    <% if (currentUser && listing.owner && String(listing.owner._id || listing.owner) === String(currentUser._id)) { %>
      <div class="d-flex gap-2 mb-4">
        <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark rounded-pill px-4 fw-semibold">
          <i class="fa-solid fa-pen-to-square me-1"></i> Edit Listing
        </a>
        <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="d-inline">
          <button type="submit" class="btn btn-outline-danger rounded-pill px-4 fw-semibold" onclick="return confirm('Are you sure you want to delete this listing?');">
            <i class="fa-solid fa-trash me-1"></i> Delete
          </button>
        </form>
      </div>
    <% } %>

    <!-- Interactive Map Section -->
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
      <h5 class="fw-bold mb-3"><i class="fa-solid fa-map-location-dot text-danger me-2"></i> Where you'll be</h5>
      <p class="text-muted fs-7 mb-3"><%= listing.location %>, <%= listing.country %></p>
      <div id="map" 
           data-coordinates="<%= JSON.stringify((listing.geometry && listing.geometry.coordinates) ? listing.geometry.coordinates : [77.2090, 28.6139]) %>"
           data-title="<%= listing.title %>"
           data-location="<%= listing.location %>, <%= listing.country %>"
           style="height: 350px; width: 100%; border-radius: 1rem;" 
           class="shadow-sm">
      </div>
    </div>

    <!-- Reviews Section -->
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
      <% if (currentUser) { %>
        <h4 class="fw-bold mb-3">Leave a Review</h4>
        <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation mb-4">
          <div class="mb-3">
            <label class="form-label fw-semibold">Rating</label>
            <fieldset class="starability-slot">
              <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
              <input type="radio" id="first-rate1" name="review[rating]" value="1" />
              <label for="first-rate1" title="Terrible">1 star</label>
              <input type="radio" id="first-rate2" name="review[rating]" value="2" />
              <label for="first-rate2" title="Not good">2 stars</label>
              <input type="radio" id="first-rate3" name="review[rating]" value="3" />
              <label for="first-rate3" title="Average">3 stars</label>
              <input type="radio" id="first-rate4" name="review[rating]" value="4" />
              <label for="first-rate4" title="Very good">4 stars</label>
              <input type="radio" id="first-rate5" name="review[rating]" value="5" />
              <label for="first-rate5" title="Amazing">5 stars</label>
            </fieldset>
          </div>

          <div class="mb-3">
            <label for="comment" class="form-label fw-semibold">Comments</label>
            <textarea id="comment" name="review[comment]" rows="4" class="form-control rounded-3" placeholder="Share your experience staying here..." required></textarea>
            <div class="invalid-feedback">Please enter comments for your review.</div>
          </div>

          <button type="submit" class="btn btn-outline-dark rounded-pill px-4 fw-semibold">Submit Review</button>
        </form>
        <hr class="my-4">
      <% } %>

      <h5 class="fw-bold mb-3">All Reviews (<%= listing.reviews ? listing.reviews.length : 0 %>)</h5>
      
      <% if (!listing.reviews || listing.reviews.length === 0) { %>
        <p class="text-muted">No reviews yet. Be the first to leave a review!</p>
      <% } else { %>
        <div class="row row-cols-1 row-cols-md-2 g-3">
          <% for (let review of listing.reviews) { %>
            <div class="col">
              <div class="card h-100 border rounded-3 p-3 bg-light shadow-sm">
                <div class="d-flex align-items-center justify-content-between mb-2">
                  <div class="d-flex align-items-center">
                    <div class="user-avatar bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center me-2" style="width:30px; height:30px; font-size:12px;">
                      <%= (review.author && review.author.username) ? review.author.username.charAt(0).toUpperCase() : 'U' %>
                    </div>
                    <span class="fw-bold text-dark fs-7"><%= (review.author && review.author.username) ? review.author.username : 'User' %></span>
                  </div>
                  <% if (currentUser && review.author && String(review.author._id || review.author) === String(currentUser._id)) { %>
                    <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" class="m-0">
                      <button type="submit" class="btn btn-link text-danger p-0 border-0" title="Delete Review">
                        <i class="fa-solid fa-trash-can"></i>
                      </button>
                    </form>
                  <% } %>
                </div>
                <p class="starability-result mb-2" data-rating="<%= review.rating %>"></p>
                <p class="card-text text-secondary fs-7 mb-0"><%= review.comment %></p>
              </div>
            </div>
          <% } %>
        </div>
      <% } %>
    </div>

  </div>
</div>

<!-- Map Script -->
<script>
  document.addEventListener("DOMContentLoaded", function () {
    const mapElement = document.getElementById("map");
    if (!mapElement) return;

    let coordinates = [77.2090, 28.6139];
    try {
      coordinates = JSON.parse(mapElement.dataset.coordinates);
    } catch (e) {
      console.error("Error parsing coordinates:", e);
    }

    const listingTitle = mapElement.dataset.title || "";
    const listingLocation = mapElement.dataset.location || "";

    const lat = coordinates[1] || 28.6139;
    const lng = coordinates[0] || 77.2090;

    if (typeof L !== "undefined") {
      const map = L.map('map').setView([lat, lng], 12);

      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '&copy; OpenStreetMap contributors'
      }).addTo(map);

      const customIcon = L.divIcon({
        className: 'custom-map-marker',
        html: `<div style="background-color:#fe424d; width:32px; height:32px; border-radius:50%; display:flex; align-items:center; justify-content:center; color:white; border:2px solid white; box-shadow: 0 2px 6px rgba(0,0,0,0.3);"><i class="fa-solid fa-house" style="font-size:14px;"></i></div>`,
        iconSize: [32, 32],
        iconAnchor: [16, 32],
        popupAnchor: [0, -32]
      });

      L.marker([lat, lng], { icon: customIcon })
        .addTo(map)
        .bindPopup(`<b>${listingTitle}</b><br>${listingLocation}`)
        .openPopup();
    }
  });
</script>


